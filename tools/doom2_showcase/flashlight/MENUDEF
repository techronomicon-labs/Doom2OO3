OptionValue SDVKFlashlightShadowModes
{
    0, "Off"
    1, "Stencil"
    2, "Depth"
}

OptionMenu "SDVKFlashlightOptions"
{
    Title "Local Flashlight"
    Command "Toggle flashlight (L)", "netevent SDVKFlashlightToggle"
    Option "Flashlight shadows", "gl_shadow_puppets", "SDVKFlashlightShadowModes"
    Slider "Depth edge softness", "gl_shadow_puppet_softness", 0.0, 2.0, 0.25, 2
    Slider "Power (%)", "sdvk_fl_power", 0, 100, 5, 0
    Slider "Horizontal spread (degrees)", "sdvk_fl_horizontal", 28, 84, 2, 0
    Slider "Vertical spread (degrees)", "sdvk_fl_vertical", 28, 84, 2, 0
    Slider "Reach (map units)", "sdvk_fl_range", 128, 768, 32, 0
    Option "Flashlight on weapon and actors", "sdvk_fl_lightactors", "OnOff"
    StaticText "OFF keeps world surfaces lit, but excludes actor sprites/models."
    StaticText "Different H/V spreads use 3 or 5 overlapping soft cones."
    StaticText " "
    Submenu "Position and aim", "SDVKFlashlightMount"
    Command "Reset flashlight settings", "resetcvar gl_shadow_puppets; resetcvar gl_shadow_puppet_softness; resetcvar sdvk_fl_power; resetcvar sdvk_fl_horizontal; resetcvar sdvk_fl_vertical; resetcvar sdvk_fl_range; resetcvar sdvk_fl_lightactors; resetcvar sdvk_fl_offset_x; resetcvar sdvk_fl_offset_y; resetcvar sdvk_fl_offset_z; resetcvar sdvk_fl_aim_yaw; resetcvar sdvk_fl_aim_pitch"
}

AddOptionMenu "OptionsMenu"
{
    Submenu "Local Flashlight", "SDVKFlashlightOptions"
}

AddOptionMenu "PBRMaterialMenu"
{
    Submenu "Flashlight settings", "SDVKFlashlightOptions"
}

OptionMenu "SDVKFlashlightMount"
{
    Title "Flashlight Position and Aim"
    Slider "X offset (forward / back)", "sdvk_fl_offset_x", -16, 16, 1, 0
    Slider "Y offset (right / left)", "sdvk_fl_offset_y", -16, 16, 1, 0
    Slider "Z offset (up / down)", "sdvk_fl_offset_z", -16, 16, 1, 0
    Slider "Aim offset right / left (degrees)", "sdvk_fl_aim_yaw", -30, 30, 2, 0
    Slider "Aim offset up / down (degrees)", "sdvk_fl_aim_pitch", -30, 30, 2, 0
    StaticText "Positive moves forward, right or up."
    StaticText "The mount and beam tilt with mouselook."
    Command "Reset position and aim", "resetcvar sdvk_fl_offset_x; resetcvar sdvk_fl_offset_y; resetcvar sdvk_fl_offset_z; resetcvar sdvk_fl_aim_yaw; resetcvar sdvk_fl_aim_pitch"
}
